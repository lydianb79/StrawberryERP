# Kopieren nach .env und Werte anpassen:  cp .env.example .env
# Zufallswerte erzeugen:  openssl rand -base64 36

DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-aendern
JWT_SECRET=bitte-mindestens-32-zufaellige-zeichen

# Erster Administrator (wird nur beim allerersten Start angelegt).
# Bleibt ADMIN_PASSWORD leer, wird ein Zufallspasswort erzeugt und im Log ausgegeben.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# true = Beispieldaten beim ersten Start anlegen (nur für Tests/Demo)
SEED_DEMO=false

# Auf true setzen, sobald die Anwendung über HTTPS erreichbar ist
COOKIE_SECURE=false

# Port auf dem Host
APP_PORT=8080

# false = keine Abfrage bei GitHub, ob ein neues Release verfügbar ist
UPDATE_CHECK=true
